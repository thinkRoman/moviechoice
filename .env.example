# ===================================================================
# MovieChoice — Environment Variables Template
# ===================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local, .env, or real secrets to git.
# In production, set these in the Vercel project Environment Variables.
# ===================================================================

# -------------------------------------------------------------------
# Database (MongoDB Atlas)
# -------------------------------------------------------------------
# Connection string from Atlas. Put the database name in the URI path.
# Example: ...mongodb.net/moviechoice?retryWrites=true&w=majority
# Do NOT use a separate MONGODB_DB variable.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/moviechoice?retryWrites=true&w=majority

# -------------------------------------------------------------------
# NextAuth / Auth.js
# Either AUTH_SECRET or NEXTAUTH_SECRET works (AUTH_SECRET preferred in Auth.js v5).
AUTH_SECRET=generate-a-random-32-char-string-here
NEXTAUTH_SECRET=generate-a-random-32-char-string-here
NEXTAUTH_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com
OWNER_PIN=123456

# -------------------------------------------------------------------
# TMDB (The Movie Database API)
# -------------------------------------------------------------------
TMDB_API_READ_ACCESS_TOKEN=your-tmdb-read-access-token-here
TMDB_BASE_URL=https://api.themoviedb.org/3

# -------------------------------------------------------------------
# OpenAI (AI Layer)
# -------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1000

# -------------------------------------------------------------------
# Google OAuth (NextAuth — Sign in with Google)
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------------------------------
# Resend (Email Magic-Link via NextAuth)
# -------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=admin@mail.thinkroman.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------------
# Cache
# -------------------------------------------------------------------
CACHE_TTL=3600

# -------------------------------------------------------------------
# Deployment (Production — override NEXTAUTH_URL)
# -------------------------------------------------------------------
# NEXTAUTH_URL=https://moviechoice.vercel.app
